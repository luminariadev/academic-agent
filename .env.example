# =====================================================================
# Academic Agent Configuration Environment Variables
# =====================================================================

# --- 9Router / LLM Inference Gateway ---
ROUTER_API_BASE=http://127.0.0.1:20128/v1
ROUTER_API_KEY=your_router_api_key_here
ROUTER_MODEL=mr-loverman
# Optional fallback models: coding-general, frontend-dev, backend-apis

# --- Discord Bot Integration ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here
DISCORD_ALLOWED_USERS=your_discord_user_id_here
GATEWAY_ALLOW_ALL_USERS=false

# --- n8n Automation Orchestrator Settings ---
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/academic-task
N8N_BASIC_AUTH_ACTIVE=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# --- Directory & Storage Settings ---
WATCH_FOLDER=./tugas_mahasiswa
BACKUP_FOLDER=./backup_tugas
DATA_FOLDER=./data
CALENDAR_FOLDER=./data/calendar
DATABASE_URL=sqlite:///./data/tasks.db

# --- Python Webhook & Bridge Service ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
